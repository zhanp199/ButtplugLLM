# Copy to .env and adjust as needed. All values have sane defaults in config.py.

# Intiface Central WebSocket address (start Intiface Central and enable the server)
INTIFACE_URL=ws://127.0.0.1:12345

# Standalone MCP server (device control surface)
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Web app (chat UI + control REST)
APP_HOST=127.0.0.1
APP_PORT=8080

# LM Studio OpenAI-compatible endpoint. Start the LM Studio local server and load a
# tool-calling capable model. MODEL is whatever the server reports (often ignored).
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=lm-studio

# How the LLM controls the device:
#   prompt  = model emits inline [[command]] tags (works with ANY model, incl.
#             uncensored / Gemma-style models with no system role or tool support)
#   native  = OpenAI function-calling (only models with a proper tool template)
LLM_TOOL_MODE=prompt

# How the prompt reaches the model:
#   chat   = /v1/chat/completions (LM Studio applies the model's chat template)
#   gemma  = /v1/completions with a hand-built Gemma prompt, bypassing the chat
#            template. Set this for Gemma 4 / *-uncensored builds that error with
#            "Cannot call something that is not a function: got UndefinedValue"
#            (their template calls strftime_now, which LM Studio can't render).
LLM_PROMPT_FORMAT=chat

# --- Safety ---
# Hard ceiling on actuator intensity (0.0 - 1.0). The LLM cannot exceed this.
MAX_INTENSITY=1.0
# Max single-command / per-step duration in ms.
MAX_DURATION_MS=30000
# Deadman switch: stop an actuator if it has had no refreshed command within this
# many seconds and has no explicit duration / running pattern.
WATCHDOG_TIMEOUT_S=15
# Typing this word (or sending a stop control) immediately stops everything,
# bypassing the LLM entirely.
SAFE_WORD=red
